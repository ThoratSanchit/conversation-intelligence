# Server Configuration
PORT=8800
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=saasquatch_db
DB_LOGGING=false

# Optional DATABASE_URL (for deployment like Neon)
# DATABASE_URL=postgres://postgres:password@localhost:5432/saasquatch_db

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
